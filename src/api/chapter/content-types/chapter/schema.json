{
  "kind": "collectionType",
  "collectionName": "chapters",
  "info": {
    "singularName": "chapter",
    "pluralName": "chapters",
    "displayName": "Chapter"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 200,
      "required": true
    },
    "artist": {
      "type": "string",
      "maxLength": 200
    },
    "track_name": {
      "type": "string",
      "maxLength": 200
    },
    "start_time_seconds": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "end_time_seconds": {
      "type": "integer"
    },
    "streaming_links": {
      "type": "json"
    },
    "mix": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::mix.mix",
      "inversedBy": "chapters"
    }
  }
}
